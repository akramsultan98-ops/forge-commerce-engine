# ─────────────────────────────────────────────────────────────────────────────
# FORGE — environment configuration
# Copy to `.env` and fill in what you have. NEVER commit a real `.env`.
# Every integration is optional: FORGE shows a clear "not connected" state for
# anything without credentials and never fakes a connection.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of the app (used for canonical URLs, OAuth callbacks, tracked links).
APP_URL=http://localhost:3000
NODE_ENV=development

# DEMO_MODE=true seeds labelled demo data and HARD-BLOCKS every outbound side effect:
# no real emails, no Telegram messages, no social posts, no Shopify writes, no orders,
# no paid AI calls (the deterministic template engine is used instead).
DEMO_MODE=true

# Reverse proxies whose X-Forwarded-For header is trusted: comma-separated IPs, CIDR blocks, or the
# presets loopback / private / linklocal. Empty (default) = no forwarding header is trusted and the
# TCP peer is the client IP. Behind Caddy/nginx/a load balancer list ONLY that proxy's address
# (e.g. the proxy container's fixed IP). Never list a range untrusted clients can reach from.
TRUSTED_PROXIES=

# ── Database ─────────────────────────────────────────────────────────────────
# Production: a real PostgreSQL connection string.
#   DATABASE_URL=postgres://forge:forge@localhost:5432/forge
# Zero-dependency local dev: embedded PostgreSQL (PGlite) stored on disk.
#   DATABASE_URL=pglite://./.data/pglite
DATABASE_URL=pglite://./.data/pglite
DATABASE_POOL_MAX=10

# ── Auth & crypto ────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-32-random-bytes-base64
# Used to encrypt third-party credentials at rest (AES-256-GCM). 32 bytes, base64. Rotate carefully.
ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Session lifetime in days
SESSION_TTL_DAYS=14

# ── Background jobs ──────────────────────────────────────────────────────────
# embedded = the job runner starts inside the Next.js server process (single-process deploys, PGlite dev)
# external = run `npm run worker` as a separate process (recommended in production)
JOB_RUNNER=embedded
WORKER_CONCURRENCY=2

# ── AI providers (server-side only — never exposed to the browser) ────────────
# Provider used when no per-organization override is saved in Settings → AI.
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible local server (Ollama, LM Studio, vLLM), e.g. http://localhost:11434/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# ── Shopify (Admin API) ───────────────────────────────────────────────────────
# Public/custom app OAuth (webhooks are registered automatically after connecting and signed with the client secret):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory
SHOPIFY_API_VERSION=2026-07
# Or a single-store custom app token (skips OAuth):
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# Single-token setups only: the store-level webhook signing secret shown under Shopify admin →
# Settings → Notifications → Webhooks. Accepted only for SHOPIFY_SHOP_DOMAIN.
SHOPIFY_WEBHOOK_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email provider: resend (implemented) | none
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
EMAIL_FROM="FORGE <alerts@example.com>"
ALERT_EMAIL_TO=

# ── Affiliate networks (per-network API credentials; postback secrets) ───────
# JSON map of network slug → credentials. Stored encrypted in the DB once saved via the UI;
# these env values are only used as bootstrap defaults.
AFFILIATE_API_KEYS={}
# Shared secret used to sign conversion postback URLs when a network has no own secret.
AFFILIATE_POSTBACK_SECRET=replace-with-random-string

# ── Product discovery sources ────────────────────────────────────────────────
CJ_API_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Wikimedia pageviews are a free, official, no-key interest signal. Set false to disable network calls.
TRENDS_WIKIPEDIA_ENABLED=true

# ── Social platforms (official APIs only) ────────────────────────────────────
# TikTok Content Posting API (direct posting requires TikTok app audit; unaudited apps post privately)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta (Facebook Pages + Instagram Graph API content publishing; Business/Creator account required)
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# YouTube Data API v3 (OAuth; uploads from unverified apps are private)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Pinterest API v5 (approved app + access token with pins:write)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# X API v2 — must be an OAuth 2.0 *user-context* token with tweet.write (app-only bearer tokens cannot post)
X_USER_ACCESS_TOKEN=

# ── Analytics / observability ────────────────────────────────────────────────
# JSON map of optional analytics keys (e.g. {"plausible":"...","ga4":"..."}); FORGE's own tracking needs none.
ANALYTICS_KEYS={}
# Error tracking hook (Sentry-compatible DSN). Empty = log only.
ERROR_TRACKING_DSN=
LOG_LEVEL=info

# ── Storefront ───────────────────────────────────────────────────────────────
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD
DEFAULT_MARKET=US
# Comma-separated extra hostnames allowed for next/image optimisation (supplier CDNs).
IMAGE_REMOTE_HOSTS=cdn.shopify.com,ae01.alicdn.com,cf.cjdropshipping.com,m.media-amazon.com
